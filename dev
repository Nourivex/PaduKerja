}

# ─────────────────────────────────────────────
# Version
# ─────────────────────────────────────────────

show_version() {
    printf '%s v%s\n' "$APP_NAME" "$APP_VERSION"
    printf '%s\n' "$APP_AUTHOR"
}


# ─────────────────────────────────────────────
# Environment information
# ─────────────────────────────────────────────

get_php_version() {
    php -r 'echo PHP_VERSION;' 2>/dev/null || echo "unknown"
}

get_ddev_version() {
    ddev version 2>/dev/null | head -n 1 || echo "unknown"
}

get_laravel_version() {
    if ! is_laravel_project; then
        echo "not a Laravel project"
        return
    fi

    if has_ddev && has_ddev_project; then
        ddev artisan --version 2>/dev/null || echo "unknown"
    elif has_php; then
        php artisan --version 2>/dev/null || echo "unknown"
    else
        echo "unknown"
    fi
}

show_env() {
    local environment
    environment="$(detect_environment)"

    printf '\n'
    printf '%s\n' "$APP_NAME"
    printf '%s\n' "────────────────────────────────────────"

    printf 'Author         %s\n' "$APP_AUTHOR"
    printf 'Version        %s\n' "$APP_VERSION"

    printf '\n'
    printf '%s\n' "Project"
    printf '%s\n' "────────────────────────────────────────"

    if is_laravel_project; then
        printf 'Laravel        %s\n' "$(get_laravel_version)"
    else
        printf 'Laravel        not detected\n'
    fi

    printf '\n'
    printf '%s\n' "Environment"
    printf '%s\n' "────────────────────────────────────────"

    if has_php; then
        printf 'PHP            %s\n' "$(get_php_version)"
    else
        printf 'PHP            not found\n'
    fi

    if has_ddev; then
        printf 'DDEV           %s\n' "$(get_ddev_version)"
    else
        printf 'DDEV           not found\n'
    fi

    printf '\n'
    printf '%s\n' "Backend"
    printf '%s\n' "────────────────────────────────────────"

    case "$environment" in
        ddev)
            printf 'Selected       DDEV\n'
            printf 'Reason         DDEV project detected\n'
            ;;
        php)
            printf 'Selected       Local PHP\n'
            printf 'Reason         DDEV unavailable\n'
            ;;
        none)
            printf 'Selected       None\n'
            printf 'Reason         Neither DDEV nor PHP found\n'
            ;;
    esac

    printf '\n'
}

# ─────────────────────────────────────────────
# Doctor
# ─────────────────────────────────────────────

show_doctor() {
    local failed=0
    local environment

    printf '\n'
    printf '%s\n' "$APP_NAME — Doctor"
    printf '%s\n' "────────────────────────────────────────"

    if is_laravel_project; then
        success "Laravel project      artisan found"
    else
        error "Laravel project      artisan not found"
        failed=1
    fi

    if has_php; then
        success "PHP                  $(get_php_version)"
    else
        warning "PHP                  not found"
    fi

    if has_ddev; then
        success "DDEV                 installed"
    else
        warning "DDEV                 not found"
    fi

    if has_ddev_project; then
        success ".ddev/config.yaml    found"
    else
        warning ".ddev/config.yaml    not found"
    fi

    environment="$(detect_environment)"

    printf '\n'
    printf '%s\n' "Environment"
    printf '%s\n' "────────────────────────────────────────"

    case "$environment" in
        ddev)
            success "Backend              DDEV"
            success "Status               READY"
            ;;

        php)
            success "Backend              Local PHP"
            success "Status               READY"
            ;;

        none)
            error "Backend              unavailable"
            error "Status               NOT READY"
            failed=1
            ;;
    esac

    printf '\n'

    if [[ "$failed" -eq 0 ]]; then
        success "Environment check passed."
    else
        error "Environment check failed."
    fi

    printf '\n'

    return "$failed"
}

# ─────────────────────────────────────────────
# Run Artisan
# ─────────────────────────────────────────────

run_artisan() {
    local environment

    if ! is_laravel_project; then
        error "Laravel project not detected."
        error "Run this command from the Laravel project root."
        return 1
    fi

    environment="$(detect_environment)"

    case "$environment" in
        ddev)
            info "Using DDEV"
            exec ddev artisan "$@"
            ;;

        php)
            info "Using local PHP"
            exec php artisan "$@"
            ;;

        none)
            error "Cannot run Laravel Artisan."
            printf '\n'
            printf 'Neither DDEV nor PHP was found.\n'
            printf '\n'
            printf 'Install one of:\n'
            printf '  • DDEV: https://ddev.com/get-started/\n'
            printf '  • PHP:  https://www.php.net/downloads.php\n'
            printf '\n'
            return 1
            ;;
    esac
}

# ─────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────

main() {
    if [[ "$#" -eq 0 ]]; then
        show_help
        return 0
    fi

    case "$1" in
        -h|--help)
            show_help
            ;;

        -v|--version)
            show_version
            ;;

        --setup)
            run_setup
            ;;

        --doctor)
            show_doctor
            ;;

        --env)
            show_env
            ;;

        *)
            run_artisan "$@"
            ;;
    esac
}

main "$@"
